# =================================================================
# Gemini API Configuration
# =================================================================

# Your Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=YOUR_API_KEY_HERE

# Gemini Model ID (approved models only)
# Options:
#   - gemini-2.5-pro (recommended for high quality)
#   - gemini-2.5-flash-preview-09-2025 (fast, good balance)
#   - gemini-2.5-flash-lite-preview-09-2025 (lightweight)
VITE_GEMINI_MODEL=gemini-2.5-pro

# =================================================================
# Notes
# =================================================================
# 1. Copy this file to .env and fill in your actual API key
# 2. Never commit .env file to version control
# 3. Use only approved model IDs listed above
